@{
    ViewData["Title"] = "Tour Booking";
    Layout = "_Layout";
    string? tourName = Context.Request.Query["tour"];
}

<!-- In _Layout.cshtml (main layout) -->
<link rel="stylesheet" href="~/css/site.css" />

<!-- Back Button -->
<section class="booking-header">
    <a href="/WhatsOn/Tours" class="back-button">← Back to Tours</a>
</section>

<!-- Booking Form Section -->
<section class="booking-section">
    <div class="booking-container">
        <h2 class="booking-title">Tour - Booking</h2>

        <form id="bookingForm" class="booking-form">

            <!-- Tour Name -->
            <div class="form-group">
                <label for="tour">TOUR:</label>
                <input type="text" id="tour" name="tour" value="@(tourName ?? "")" placeholder="Select tour" required />
            </div>

            <!-- Date -->
            <div class="form-group">
                <label for="date">DATE:</label>
                <select id="date" name="date" required>
                    <option value="">Select a date</option>
                    <option value="2026-04-15">April 15, 2026</option>
                    <option value="2026-04-20">April 20, 2026</option>
                    <option value="2026-04-25">April 25, 2026</option>
                    <option value="2026-05-01">May 1, 2026</option>
                    <option value="2026-05-10">May 10, 2026</option>
                </select>
            </div>

            <!-- Time -->
            <div class="form-group">
                <label for="time">TIME:</label>
                <select id="time" name="time" required>
                    <option value="">Select a time</option>
                    <option value="10:00">10:00 AM</option>
                    <option value="11:30">11:30 AM</option>
                    <option value="14:00">2:00 PM</option>
                    <option value="15:30">3:30 PM</option>
                    <option value="16:45">4:45 PM</option>
                </select>
            </div>

            <!-- Quantity -->
            <div class="form-group">
                <label for="quantity">QUANTITY:</label>
                <select id="quantity" name="quantity" required>
                    <option value="">Select quantity</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="8">8</option>
                    <option value="10">10</option>
                </select>
            </div>

            <!-- Accessibility Notice -->
            <div class="accessibility-notice">
                <p>AT THE NATURAL GALLERY WE STRIVE FOR INCLUSIVITY. IF YOU REQUIRE A COMPANION FOR YOUR VISIT PLEASE FILL THE FOLLOWING BOX.</p>
                <input type="checkbox" id="companion" name="companion" />
                <label for="companion">I require a companion</label>
            </div>

            <!-- Email -->
            <div class="form-group">
                <label for="email">EMAIL:</label>
                <input type="email" id="email" name="email" placeholder="your.email@example.com" required />
            </div>

            <!-- Phone -->
            <div class="form-group">
                <label for="phone">PHONE:</label>
                <input type="tel" id="phone" name="phone" placeholder="Optional" />
            </div>

            <!-- Pay Button -->
            <button type="submit" class="pay-button">PAY</button>

        </form>
    </div>
</section>

<script>
    document.getElementById('bookingForm').addEventListener('submit', function(e) {
        e.preventDefault();

        // Collect form data
        const tour = document.getElementById('tour').value;
        const date = document.getElementById('date').value;
        const time = document.getElementById('time').value;
        const quantity = document.getElementById('quantity').value;
        const email = document.getElementById('email').value;
        const phone = document.getElementById('phone').value;
        const companion = document.getElementById('companion').checked;

        // Validate form
        if (!tour || !date || !time || !quantity || !email) {
            alert('Please fill in all required fields');
            return;
        }

        // Create booking object
        const booking = {
            tour: tour,
            date: date,
            time: time,
            quantity: quantity,
            email: email,
            phone: phone,
            companion: companion,
            ticketNumber: 'TKT' + Math.random().toString().substr(2, 16).padEnd(16, '0'),
            bookingDate: new Date().toISOString()
        };

        // Store in session storage and redirect to ticket
        sessionStorage.setItem('lastBooking', JSON.stringify(booking));
        window.location.href = '/WhatsOn/Ticket';
    });
</script>