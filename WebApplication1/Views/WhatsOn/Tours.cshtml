@model List<WebApplication1.Models.Tour>
@{
    ViewData["Title"] = "Tours";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/whatson.css" />

<!-- Hero Banner -->
<section class="hero-banner">
    <img src="~/images/Picture27.png" alt="Gallery Tours" class="banner-image" />
    <div class="banner-overlay">
        <h1 class="banner-title">TOURS</h1>
        <p class="banner-subtitle">EXPLORE OUR GALLERY EXPERIENCES</p>
    </div>
</section>

<!-- Custom Tours Notice -->
<section class="tours-notice">
    <p>FOR CUSTOM SCHOOL & BUSINESS TOURS PLEASE ENQUIRE AT +44 (0)20 8811 8000</p>
</section>

<!-- Tours List - LOOPS THROUGH DATABASE -->
<section class="tours-list-section">
    <div class="tours-container">

        @if (Model != null && Model.Count > 0)
        {
            @foreach (var tour in Model)
            {
                <!-- Alternating light/dark background -->
                <div class="tour-card-detailed @(Model.IndexOf(tour) % 2 == 0 ? "" : "tour-light-bg")">
                    <div class="tour-card-left">
                        <img src="@Url.Content(tour.ImagePath)" alt="@tour.Title" class="tour-image-large" />
                    </div>
                    <div class="tour-card-right @(Model.IndexOf(tour) % 2 == 0 ? "tour-dark" : "")">
                        <h3 class="tour-title @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light")">@tour.Title.ToUpper()</h3>
                        <p class="tour-meta @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light")">@tour.Genre</p>
                        <p class="tour-description @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light")">
                            @tour.Description
                        </p>
                        <ul class="tour-details @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light")">
                            <li>DURATION: @tour.Duration</li>
                            <li>LOCATION: @tour.Location</li>
                            <li>GROUP SIZE: UP TO @tour.SpotsPerSlot PEOPLE</li>
                            @if (!string.IsNullOrEmpty(tour.TimeInfo))
                            {
                                <li>AVAILABILITY: @tour.TimeInfo</li>
                            }
                        </ul>
                        <div class="tour-actions">
                            <!-- BOOK button links to TourBook action with TourId -->
                            <a asp-action="TourBook" asp-route-id="@tour.TourId"
                               class="tour-book-btn @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light")">BOOK</a>
                            <a href="/WhatsOn/TourDetail/@tour.TourId" class=" =" tour-view-btn></a>

                            <!-- Heart button for favourites -->
                            <button type="button"
                                    class="tour-heart-icon @(Model.IndexOf(tour) % 2 == 0 ? "" : "-light") heart-btn-@tour.TourId"
                                    onclick="toggleTourFavourite(@tour.TourId)"
                                    title="Save to favourites">
                                ♡
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="text-align: center; color: #999; padding: 40px;">No tours available at this time.</p>
        }

    </div>
</section>

<script>
    // Toggle tour favourite via AJAX
    function toggleTourFavourite(tourId) {
        fetch('/WhatsOn/ToggleTourFavouriteAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tourId: tourId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (!data.success) {
                alert(data.message);
                return;
            }
            var btn = document.querySelector('.heart-btn-' + tourId);
            if (data.favourited) {
                btn.classList.add('active');
                btn.textContent = '♥';
            } else {
                btn.classList.remove('active');
                btn.textContent = '♡';
            }
        });
    }

    // On page load, check which tours are already favourited
    document.querySelectorAll('.tour-card-detailed').forEach(function(card) {
        var buttons = card.querySelectorAll('[class*="heart-btn-"]');
        if (buttons.length > 0) {
            var btn = buttons[0];
            var classes = btn.className.split(' ');
            var heartBtnClass = classes.find(c => c.startsWith('heart-btn-'));
            var tourId = heartBtnClass ? heartBtnClass.split('-')[2] : null;

            if (tourId) {
                fetch('/WhatsOn/IsTourFavourited?tourId=' + tourId)
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.favourited) {
                            btn.classList.add('active');
                            btn.textContent = '♥';
                        }
                    });
            }
        }
    });
</script>