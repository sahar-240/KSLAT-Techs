<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Natural Gallery</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-left">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-leaf"></i> Natural Gallery
                </a>
            </div>
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">VISIT US</a></li>
                <li><a asp-controller="WhatsOn" asp-action="Index">WHAT'S ON</a></li>
                <li><a asp-controller="Amenities" asp-action="Index">AMENITIES</a></li>
                <li><a asp-controller="Membership" asp-action="Index">MEMBERSHIP</a></li>
            </ul>
            <div class="navbar-right">
                <a href="#" class="search-icon" id="search-toggle" onclick="toggleSearch(event)">
                    <i class="fas fa-search"></i>
                </a>
            </div>
        </div>

        <!-- Search bar - slides open when the magnifying glass is clicked -->
        <div class="search-overlay" id="search-overlay" style="display:none; background:#1a1a1a; padding:16px 40px;">
            <div style="max-width:700px; margin:0 auto; position:relative;">
                <input type="text" id="search-input" placeholder="Search events, exhibitions, workshops..."
                       autocomplete="off"
                       style="width:100%; padding:12px 44px 12px 16px; font-size:1rem; border:2px solid #2d5f3f; border-radius:6px; background:#2b2b2b; color:#fff; outline:none;" />
                <i class="fas fa-search" style="position:absolute; right:16px; top:50%; transform:translateY(-50%); color:#999;"></i>

                <!-- Live search results appear here -->
                <div id="search-results" style="display:none; position:absolute; top:100%; left:0; right:0; background:#2b2b2b; border:1px solid #444; border-top:none; border-radius:0 0 6px 6px; max-height:350px; overflow-y:auto; z-index:1000;"></div>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>Natural Gallery</h4>
                    <p>Inspiring curiosity about the natural world</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Visit Us</a></li>
                        <li><a asp-controller="WhatsOn" asp-action="Index">What's On</a></li>
                        <li><a asp-controller="Amenities" asp-action="Index">Amenities</a></li>
                        <li><a asp-controller="Membership" asp-action="Index">Membership</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Support">Support</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contact</h4>
                    <p>📍 Cromwell Rd, South Kensington, London SW7 5BD</p>
                    <p>📞 +44 (0)20 8991 0200</p>
                    <p>✉ info@naturalgallery.co.uk</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Natural Gallery. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Search bar functionality -->
    <script>
            // Open or close the search overlay
            function toggleSearch(e) {
                e.preventDefault();
                var overlay = document.getElementById('search-overlay');
                var input = document.getElementById('search-input');

                if (overlay.style.display === 'none') {
                    overlay.style.display = 'block';
                    input.focus();
                } else {
                    overlay.style.display = 'none';
                    input.value = '';
                    document.getElementById('search-results').style.display = 'none';
                }
            }

            // Debounce timer so the API is not called on every single keystroke
            var searchTimer = null;

            document.addEventListener('DOMContentLoaded', function () {
                var input = document.getElementById('search-input');
                var resultsDiv = document.getElementById('search-results');

                input.addEventListener('input', function () {
                    clearTimeout(searchTimer);
                    var query = input.value.trim();

                    // Need at least 2 characters before searching
                    if (query.length < 2) {
                        resultsDiv.style.display = 'none';
                        return;
                    }

                    // Wait 300ms after the user stops typing, then search
                    searchTimer = setTimeout(function () {
                        fetch('/WhatsOn/SearchEvents?query=' + encodeURIComponent(query))
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                resultsDiv.innerHTML = '';

                                if (data.length === 0) {
                                    resultsDiv.innerHTML = '<div style="padding:14px 16px; color:#999; font-size:0.9rem;">No results found</div>';
                                    resultsDiv.style.display = 'block';
                                    return;
                                }

                                // Build a clickable row for each matching event
                                data.forEach(function (ev) {
                                    var link = document.createElement('a');
                                    link.href = '/WhatsOn/EventDetail/' + ev.eventId;
                                    link.style.cssText = 'display:flex; align-items:center; gap:12px; padding:10px 16px; text-decoration:none; color:#fff; border-bottom:1px solid #333; transition:background 0.15s;';
                                    link.onmouseover = function () { this.style.background = '#333'; };
                                    link.onmouseout = function () { this.style.background = 'none'; };

                                    link.innerHTML =
                                        '<div style="flex:1;">' +
                                            '<div style="font-weight:700; font-size:0.9rem; text-transform:uppercase; letter-spacing:0.5px;">' + ev.eventType + ': ' + ev.title + '</div>' +
                                            '<div style="color:#999; font-size:0.75rem; margin-top:2px;">' + ev.genre + ' &bull; ' + ev.location + '</div>' +
                                        '</div>' +
                                        '<i class="fas fa-chevron-right" style="color:#666; font-size:0.75rem;"></i>';

                                    resultsDiv.appendChild(link);
                                });

                                resultsDiv.style.display = 'block';
                            });
                    }, 300);
                });

                // Close search when clicking outside
                document.addEventListener('click', function (e) {
                    var overlay = document.getElementById('search-overlay');
                    var toggle = document.getElementById('search-toggle');
                    if (overlay.style.display === 'block' && !overlay.contains(e.target) && !toggle.contains(e.target)) {
                        overlay.style.display = 'none';
                        input.value = '';
                        resultsDiv.style.display = 'none';
                    }
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>