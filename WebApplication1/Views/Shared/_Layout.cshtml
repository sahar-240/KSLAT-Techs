<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Natural History Museum</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Font Awesome for Search Icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="navbar-content">
            <!-- Logo -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-icon">🏛️</span>
                <span class="brand-text">Natural<br>Gallery</span>
            </a>

            <!-- Nav Links -->
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Visit" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Visit" ? "active" : "")">VISIT US</a></li>
                <li><a asp-controller="Home" asp-action="WhatsOn" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "WhatsOn" ? "active" : "")">WHAT'S ON</a></li>
                <li><a href="#amenities" class="">AMENITIES</a></li>
                <li><a asp-controller="Home" asp-action="Support" class="">MEMBERSHIP</a></li>
            </ul>

            <!-- Search Icon -->
            <button class="search-toggle" onclick="toggleSearch()" aria-label="Search">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <!-- Search Bar -->
        <div id="search-bar" class="search-bar" style="display: none;">
            <div class="search-container">
                <input type="text" id="search-input" placeholder="SEARCH">
                <button type="button" class="search-btn" onclick="performSearch()">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>Natural History Museum</h4>
                    <p>Inspiring curiosity about the natural world</p>
                </div>
                <div class="footer-section">
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Support">Support Us</a></li>
                        <li><a asp-controller="Home" asp-action="Donation">Donate</a></li>
                        <li><a asp-controller="Home" asp-action="Visit">Visit</a></li>
                        <li><a asp-controller="Home" asp-action="WhatsOn">What's On</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Contact</h4>
                    <p>Email: <a href="mailto:info@nhm.ac.uk">info@nhm.ac.uk</a></p>
                    <p>Phone: <a href="tel:+442079425000">+44 20 7942 5000</a></p>
                    <p>Address: Cromwell Road<br>London SW7 5BD<br>United Kingdom</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Natural History Museum. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>