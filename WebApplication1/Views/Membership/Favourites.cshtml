@{
    ViewData["Title"] = "Favourites";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/membership.css" />

<div class="page-container">
    <div class="membership-hero" style="background: #1a1a1a; padding: 60px 0; text-align: center;">
        <h1 style="color: #fff; font-size: 2.5rem; letter-spacing: 3px;">MY FAVOURITES</h1>
        <p style="color: #aaa; margin-top: 10px;">Your saved events and tours</p>
    </div>

    <section style="padding: 60px; text-align: center;">
        <p style="color: #999; font-size: 1.1rem;">
            <i class="fas fa-heart" style="color: #2d5f3f; margin-right: 8px;"></i>
            Sign in to view your saved events and tours.
        </p>
        <a href="/Login" style="display: inline-block; margin-top: 20px; background: #2d5f3f; color: #fff; padding: 12px 30px; text-decoration: none; font-weight: 700; letter-spacing: 1px;">
            LOGIN
        </a>
    </section>
</div>