@model List<WebApplication1.Models.TicketViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tickets";
}

<link rel="stylesheet" href="~/css/Account.css">

    <!-- Main Content -->
    <div class="tickets-container">
        <!-- Hero Section -->
        <div class="tickets-header">
            <img src="~/images/Picture28.png" alt="Tickets" class="hero-image3" />
            <div class="hero-overlay3">
                <div class="hero-content3">
                    <h1 class="tickets-title">TICKETS</h1>
                </div>
            </div>
        </div>

        <!-- Tickets Items Section -->
        <div class="tickets-items-container">
            <div class="tickets-items">
                @if (TempData["Success"] != null)
                {
                    <div style="background: #d4edda; color: #155724; padding: 12px 20px; margin-bottom: 20px; border-radius: 6px; text-align: center;">
                        @TempData["Success"]
                    </div>
                }

                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var ticket in Model)
                    {
                        <div class="ticket-item">
                            <div class="ticket-header">
                                <h3>@ticket.Title</h3>
                                <span class="ticket-status @(ticket.Status?.ToLower() ?? "unknown")">
                                    @(ticket.Status ?? "Unknown")
                                </span>
                            </div>
                            <p class="ticket-description">@ticket.Description</p>
                            <div class="ticket-details">
                                <div class="detail-group">
                                    <span class="detail-label">DATE:</span>
                                    <span class="detail-value">@ticket.Date</span>
                                </div>
                                <div class="detail-group">
                                    <span class="detail-label">QUANTITY:</span>
                                    <span class="detail-value">@ticket.Quantity</span>
                                </div>
                                <div class="detail-group">
                                    <span class="detail-label">TICKET CODE:</span>
                                    <span class="detail-value" style="font-family: monospace;">@ticket.TicketCode</span>
                                </div>
                            <div class="detail-group">
                                <span class="detail-label">PRICE:</span>
                                <span class="detail-value">
                                    @(ticket.TotalPrice > 0 ? $"£{ticket.TotalPrice:F2}" : "FREE")
                                </span>
                            </div>
                            </div>
                            <div class="ticket-actions">
                                <a href="/WhatsOn/EventTicket?bookingId=@ticket.Id" class="view-btn">View Details</a>
                                <form method="post" action="/Account/CancelTicket" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ticketId" value="@ticket.Id" />
                                    <button type="submit" class="cancel-btn"
                                            onclick="return confirm('Are you sure you want to cancel this booking?');">
                                        Cancel
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-tickets">
                        <p>You don't have any bookings yet.</p>
                        <a href="@Url.Action("Index", "WhatsOn")" class="book-btn">Browse Events</a>
                    </div>
                }
            </div>
        </div>
    </div>