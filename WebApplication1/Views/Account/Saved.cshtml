@model List<WebApplication1.Models.SavedItemViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Saved";
}

<link rel="stylesheet" href="~/css/Account.css">

    <!-- Main Content -->
    <div class="saved-container">
        <!-- Hero Section -->
        <div class="saved-header">
            <img src="~/images/Picture29.png" alt="Saved" class="hero-image2" />
            <div class="hero-overlay2">
                <div class="hero-content2">
                    <h1 class="saved-title">SAVED</h1>
                </div>
            </div>
        </div>

        <!-- Saved Items Section -->
        <div class="saved-items-container">
            <div class="saved-items">
                @if (TempData["Success"] != null)
                {
                    <div style="background: #d4edda; color: #155724; padding: 12px 20px; margin-bottom: 20px; border-radius: 6px; text-align: center;">
                        @TempData["Success"]
                    </div>
                }

                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <div class="saved-item">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@Url.Content(item.ImagePath)" alt="@item.Title"
                                     style="width: 100%; max-height: 180px; object-fit: cover; border-radius: 6px; margin-bottom: 12px;" />
                            }
                            <h3>@item.Title</h3>
                            <p>@item.Description</p>
                            <div class="item-details">
                                <span>@item.Date</span>
                                <form method="post" asp-controller="Account" asp-action="RemoveFavourite" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="remove-btn"
                                            onclick="return confirm('Remove from saved?');">
                                        Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-saved-items">
                        <p>You haven't saved any events yet.</p>
                        <a href="/WhatsOn/Events" style="color: #2d5f3f; font-weight: 600;">Browse Events →</a>
                    </div>
                }
            </div>
        </div>
    </div>