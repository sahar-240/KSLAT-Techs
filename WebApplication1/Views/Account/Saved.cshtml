@model List<WebApplication1.Models.SavedItemViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Saved";
}

<link rel="stylesheet" href="~/css/Account.css">

    <!-- Main Content -->
    <div class="saved-container">
        <!-- Hero Section -->
        <div class="saved-header">
            <img src="~/images/Picture29.png" alt="Saved" class="hero-image2" />
            <div class="hero-overlay2">
                <div class="hero-content2">
                    <h1 class="saved-title">SAVED</h1>
                </div>
            </div>
        </div>

        <!-- Saved Items Section -->
        <div class="saved-items-container">
            <div class="saved-items">
                <!-- Saved items will be displayed here -->
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var item in Model)
                    {
                        <div class="saved-item">
                            <h3>@item.Title</h3>
                            <p>@item.Description</p>
                            <div class="item-details">
                                <span>@item.Date</span>
                                <button class="remove-btn" data-id="@item.Id">Remove</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-saved-items">
                        <p>You haven't saved any events yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.querySelectorAll('.remove-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    console.log('Remove item:', id);
                });
            });
        </script>
    }