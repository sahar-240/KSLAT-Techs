@{
    ViewData["Title"] = "Book Event";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<div class="booking-container">
    <form class="booking-form" id="booking-form">

        <!-- Event name (auto-filled from URL) -->
        <div class="booking-field">
            <label for="event-name">EVENT:</label>
            <input type="text" id="event-name" readonly>
        </div>

        <!-- Date picker -->
        <div class="booking-field">
            <label for="event-date">DATE:</label>
            <select id="event-date">
                <option value="">Select date</option>
            </select>
        </div>

        <!-- Time picker -->
        <div class="booking-field">
            <label for="event-time">TIME:</label>
            <select id="event-time">
                <option value="">Select time</option>
            </select>
        </div>

        <!-- Quantity -->
        <div class="booking-field">
            <label for="event-qty">QUANTITY:</label>
            <select id="event-qty">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
        </div>

        <!-- Email (required) -->
        <div class="booking-field">
            <label for="event-email">EMAIL:</label>
            <input type="email" id="event-email" placeholder="your email">
        </div>
        <span class="booking-error" id="email-error">Please enter a valid email address</span>

        <!-- Phone (optional, numbers only) -->
        <div class="booking-field">
            <label for="event-phone">PHONE:</label>
            <input type="tel" id="event-phone" placeholder="Optional" maxlength="15">
        </div>
        <span class="booking-error" id="phone-error">Phone must be numbers only (10-15 digits)</span>

        <!-- Submit button -->
        <button type="button" onclick="submitBooking()" class="booking-submit">BOOK</button>
    </form>
</div>

<script>
    // =============================================
    // EVENT DATA - dates and times for each event
    // This is what gets replaced by SQL later
    // =============================================
    var eventData = {
        'Iris Van Herpen': {
            start: new Date(2026, 3, 16),   // 16 Apr 2026 (months are 0-based so 3 = April)
            end: new Date(2026, 4, 31),     // 31 May 2026
            times: ['10:00 AM', '11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM']
        },
        'One Earth': {
            start: new Date(2026, 6, 7),    // 7 Jul 2026
            end: new Date(2026, 8, 15),     // 15 Sep 2026
            times: ['10:00 AM', '11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM']
        },
        'Daniel Schuller': {
            start: new Date(2026, 3, 15),   // 15 Apr 2026
            end: new Date(2026, 5, 30),     // 30 Jun 2026
            times: ['10:00 AM', '11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM']
        },
        'Thierry Mugler': {
            start: new Date(2026, 5, 22),   // 22 Jun 2026
            end: new Date(2026, 7, 4),      // 4 Aug 2026
            times: ['11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM', '6:00 PM']
        },
        'Craft Mania': {
            start: new Date(2026, 3, 12),   // 12 Apr 2026
            end: new Date(2026, 3, 14),     // 14 Apr 2026
            times: ['2:00 PM', '3:00 PM', '4:00 PM']
        },
        'Extinction Event': {
            start: new Date(2026, 7, 5),    // 5 Aug 2026
            end: new Date(2026, 9, 20),     // 20 Oct 2026
            times: ['9:00 AM', '10:00 AM', '11:00 AM', '12:00 PM', '1:00 PM', '2:00 PM', '3:00 PM', '4:00 PM', '5:00 PM']
        }
    };

    // Get event name from URL
    var params = new URLSearchParams(window.location.search);
    var eventName = params.get('event') || '';
    document.getElementById('event-name').value = eventName;

    // Look up this event's data
    var thisEvent = eventData[eventName];

    // Fill in the DATE dropdown with only valid dates for this event
    if (thisEvent) {
        var dateSelect = document.getElementById('event-date');
        var currentDate = new Date(thisEvent.start.getTime()); // copy the start date

        while (currentDate <= thisEvent.end) {
            var option = document.createElement('option');
            option.value = currentDate.toLocaleDateString('en-GB', {
                weekday: 'short',
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });
            option.textContent = option.value;
            dateSelect.appendChild(option);

            // Move to next day
            currentDate.setDate(currentDate.getDate() + 1);
        }

        // Fill in the TIME dropdown with only valid times for this event
        var timeSelect = document.getElementById('event-time');
        for (var i = 0; i < thisEvent.times.length; i++) {
            var timeOption = document.createElement('option');
            timeOption.value = thisEvent.times[i];
            timeOption.textContent = thisEvent.times[i];
            timeSelect.appendChild(timeOption);
        }
    }

    // Check if an email address looks valid
    function isValidEmail(email) {
        var parts = email.split(String.fromCharCode(64));
        if (parts.length !== 2) return false;
        if (parts[0].length === 0) return false;
        if (parts[1].indexOf('.') === -1) return false;
        return true;
    }

    // Validate and submit the form
    function submitBooking() {
        var isValid = true;

        // Hide all errors first
        document.querySelectorAll('.booking-error').forEach(function (el) {
            el.classList.remove('show');
        });

        // Check email
        var email = document.getElementById('event-email').value;
        if (!email || !isValidEmail(email)) {
            document.getElementById('email-error').classList.add('show');
            isValid = false;
        }

        // Check phone - if filled in, must be numbers only and 10-15 digits
        var phone = document.getElementById('event-phone').value;
        if (phone.length > 0) {
            var phoneRegex = /^\d{10,15}$/;
            if (!phoneRegex.test(phone)) {
                document.getElementById('phone-error').classList.add('show');
                isValid = false;
            }
        }

        // Check date is selected
        if (!document.getElementById('event-date').value) {
            isValid = false;
            alert('Please select a date');
        }

        // Check time is selected
        if (!document.getElementById('event-time').value) {
            isValid = false;
            alert('Please select a time');
        }

        // If everything is valid, go to ticket page
        if (isValid) {
            var ticketCode = generateCode();
            var qty = document.getElementById('event-qty').value;
            var bookDate = document.getElementById('event-date').value;
            var bookTime = document.getElementById('event-time').value;

            var url = '/WhatsOn/EventTicket'
                + '?event=' + encodeURIComponent(eventName)
                + '&qty=' + qty
                + '&date=' + encodeURIComponent(bookDate)
                + '&time=' + encodeURIComponent(bookTime)
                + '&ticket=' + ticketCode;

            window.location.href = url;
        }
    }

    // Generate a random ticket code like "NG-4F8A-K2M7-X9BL"
    function generateCode() {
        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
        var code = 'NG-';
        for (var i = 0; i < 12; i++) {
            if (i > 0 && i % 4 === 0) code += '-';
            code += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return code;
    }
</script>