@model WebApplication1.Models.Event
@{
    ViewData["Title"] = "Book " + Model.Title;
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<div class="booking-container">
    @if (TempData["Error"] != null)
    {
        <div style="background: #ff4444; color: #fff; padding: 12px 20px; margin-bottom: 20px; border-radius: 6px; text-align: center; font-weight: 600;">
            @TempData["Error"]
        </div>
    }

    <form class="booking-form" method="post" asp-action="EventBook" asp-route-id="@Model.EventId" id="booking-form">

        <div class="booking-field">
            <label>EVENT:</label>
            <input type="text" value="@Model.Title" readonly>
        </div>

        <div class="booking-field">
            <label for="bookingDate">DATE:</label>
            <select name="bookingDate" id="event-date">
                <option value="">Select date</option>
            </select>
        </div>

        <div class="booking-field">
            <label for="bookingTime">TIME:</label>
            <select name="bookingTime" id="event-time">
                <option value="">Select a date first</option>
            </select>
        </div>

        <!-- Available spots display -->
        <div class="booking-field" id="spots-display" style="display:none;">
            <label>AVAILABLE:</label>
            <span id="spots-count" style="font-weight: 700; font-size: 1.1rem; color: #2d5f3f;"></span>
        </div>

        <div class="booking-field">
            <label for="quantity">QUANTITY:</label>
            <select name="quantity" id="event-qty">
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
            </select>
        </div>

        <div class="booking-field">
            <label for="email">EMAIL:</label>
            <input type="email" name="email" id="event-email" placeholder="your email" required>
        </div>
        <span class="booking-error" id="email-error">Please enter a valid email address</span>

        <div class="booking-field">
            <label for="phone">PHONE:</label>
            <input type="tel" name="phone" id="event-phone" placeholder="Optional" maxlength="15">
        </div>
        <span class="booking-error" id="phone-error">Phone must be numbers only (10-15 digits)</span>

        <button type="submit" onclick="return validateBooking()" class="booking-submit">BOOK</button>
    </form>
</div>

<script>
    var startDate = new Date("@Model.StartDate.ToString("yyyy-MM-dd")");
    var endDate = new Date("@Model.EndDate.ToString("yyyy-MM-dd")");
    var timeInfo = "@Model.TimeInfo";
    var eventId = @Model.EventId;

    var weekdayOpen = 9, weekdayClose = 17;
    var satOpen = 10, satClose = 18;
    var hasSaturday = true;

    var parts = timeInfo.split(',');
    var weekdayMatch = parts[0].match(/(\d{1,2}:\d{2}\s*[AP]M)\s*-\s*(\d{1,2}:\d{2}\s*[AP]M)/i);
    if (weekdayMatch) {
        weekdayOpen = parseTimeToHour(weekdayMatch[1].trim());
        weekdayClose = parseTimeToHour(weekdayMatch[2].trim());
    }

    if (parts.length > 1) {
        var satMatch = parts[1].match(/(\d{1,2}:\d{2}\s*[AP]M)\s*-\s*(\d{1,2}:\d{2}\s*[AP]M)/i);
        if (satMatch) {
            satOpen = parseTimeToHour(satMatch[1].trim());
            satClose = parseTimeToHour(satMatch[2].trim());
        }
    } else {
        hasSaturday = false;
    }

    var dateSelect = document.getElementById('event-date');
    var currentDate = new Date(startDate.getTime());

    while (currentDate <= endDate) {
        var dayOfWeek = currentDate.getDay();
        if (dayOfWeek === 0) { currentDate.setDate(currentDate.getDate() + 1); continue; }
        if (dayOfWeek === 6 && !hasSaturday) { currentDate.setDate(currentDate.getDate() + 1); continue; }

        var option = document.createElement('option');
        option.value = currentDate.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
        option.textContent = option.value;
        option.dataset.dayOfWeek = dayOfWeek;
        dateSelect.appendChild(option);
        currentDate.setDate(currentDate.getDate() + 1);
    }

    dateSelect.addEventListener('change', function () {
        var timeSelect = document.getElementById('event-time');
        timeSelect.innerHTML = '<option value="">Select time</option>';
        document.getElementById('spots-display').style.display = 'none';
        var selected = dateSelect.options[dateSelect.selectedIndex];
        if (!selected.value) return;

        var dayOfWeek = parseInt(selected.dataset.dayOfWeek);
        var openHour = (dayOfWeek === 6) ? satOpen : weekdayOpen;
        var closeHour = (dayOfWeek === 6) ? satClose : weekdayClose;

        var museumOpen = (dayOfWeek === 6) ? 10 : 9;
        var museumClose = (dayOfWeek === 6) ? 18 : 17;
        if (openHour < museumOpen) openHour = museumOpen;
        if (closeHour > museumClose) closeHour = museumClose;

        for (var h = openHour; h < closeHour; h++) {
            var timeOption = document.createElement('option');
            timeOption.value = formatHour(h);
            timeOption.textContent = formatHour(h);
            timeSelect.appendChild(timeOption);
        }
    });

    // When time is picked, fetch available spots
    document.getElementById('event-time').addEventListener('change', function () {
        var date = document.getElementById('event-date').value;
        var time = this.value;
        if (!date || !time) {
            document.getElementById('spots-display').style.display = 'none';
            return;
        }

        fetch('/WhatsOn/GetAvailableSpots?eventId=' + eventId + '&date=' + encodeURIComponent(date) + '&time=' + encodeURIComponent(time))
            .then(function(r) { return r.json(); })
            .then(function(data) {
                document.getElementById('spots-count').textContent = data.spots + ' of ' + data.total + ' spots';
                document.getElementById('spots-display').style.display = 'flex';
            });
    });

    function parseTimeToHour(str) {
        var match = str.match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
        if (!match) return 0;
        var hour = parseInt(match[1]);
        var ampm = match[3].toUpperCase();
        if (ampm === 'PM' && hour !== 12) hour += 12;
        if (ampm === 'AM' && hour === 12) hour = 0;
        return hour;
    }

    function formatHour(h) {
        var ampm = h >= 12 ? 'PM' : 'AM';
        var displayHour = h % 12;
        if (displayHour === 0) displayHour = 12;
        return displayHour + ':00 ' + ampm;
    }

    function validateBooking() {
        var isValid = true;
        document.querySelectorAll('.booking-error').forEach(function (el) { el.classList.remove('show'); });

        var email = document.getElementById('event-email').value;
        if (!email || !isValidEmail(email)) { document.getElementById('email-error').classList.add('show'); isValid = false; }

        var phone = document.getElementById('event-phone').value;
        if (phone.length > 0 && !/^\d{10,15}$/.test(phone)) { document.getElementById('phone-error').classList.add('show'); isValid = false; }

        if (!document.getElementById('event-date').value) { isValid = false; alert('Please select a date'); }
        if (!document.getElementById('event-time').value) { isValid = false; alert('Please select a time'); }
        return isValid;
    }

    function isValidEmail(email) {
        var parts = email.split(String.fromCharCode(64));
        if (parts.length !== 2) return false;
        if (parts[0].length === 0) return false;
        if (parts[1].indexOf('.') === -1) return false;
        return true;
    }
</script>