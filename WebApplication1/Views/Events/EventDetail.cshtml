@model WebApplication1.Models.Event
@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<div class="event-detail-card">
    <div class="event-detail-image-section">
        <a href="/WhatsOn/Events" class="event-detail-back" title="Return to Events">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="event-detail-image">
            <img src="@Url.Content(Model.ImagePath)" alt="@Model.Title">
        </div>
        <div class="event-detail-title-box">
            <div class="event-detail-title-wrapper">
                <span class="event-detail-label">@Model.EventType.ToUpper()</span>
                <span class="event-detail-title" style="color: @Model.ThemeColour;">@Model.Title.ToUpper()</span>
            </div>
        </div>
    </div>

    <div class="event-detail-info" style="background-color: @Model.ThemeColour;">
        <div class="event-detail-date-box">
            <div class="event-detail-year">@Model.StartDate.Year</div>
            <div class="event-detail-date-row">
                <div class="event-detail-date-number">@Model.StartDate.ToString("dd")</div>
                <div class="event-detail-date-divider"></div>
                <div class="event-detail-date-number">@Model.EndDate.ToString("dd")</div>
            </div>
            <div class="event-detail-date-labels">
                <div class="event-detail-date-label">@Model.StartDate.ToString("MMM").ToUpper()</div>
                <div class="event-detail-date-label">@Model.EndDate.ToString("MMM").ToUpper()</div>
            </div>
        </div>

        <div class="event-detail-content">
            <div class="event-detail-item">
                <span class="event-detail-item-label">TIME</span>
                <span>@Model.TimeInfo.ToUpper()</span>
            </div>
            <div class="event-detail-item">
                <span class="event-detail-item-label">LOCATION</span>
                <span>@Model.Location.ToUpper()</span>
            </div>
            <div class="event-detail-item">
                <span class="event-detail-item-label">AVAILABILITY</span>
                <span>@Model.SpotsPerSlot SPOTS PER SLOT</span>
            </div>
            <div class="event-detail-description">
                @Model.FullDescription
            </div>
            <div class="event-detail-footer">
                @if (TempData["Success"] != null)
                {
                    <span style="color: #fff; font-weight: 600; font-size: 0.85rem; margin-right: 10px;">@TempData["Success"]</span>
                }
                @if (TempData["Error"] != null)
                {
                    <span style="color: #ffcccc; font-weight: 600; font-size: 0.85rem; margin-right: 10px;">@TempData["Error"]</span>
                }
                <form method="post" asp-controller="WhatsOn" asp-action="ToggleFavourite" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <button type="submit" class="event-detail-heart" id="heart-btn" title="Save to favourites">
                        <i class="far fa-heart" id="heart-icon"></i>
                    </button>
                </form>
                <a asp-action="EventBook" asp-route-id="@Model.EventId" class="event-detail-book-btn">BOOK</a>
            </div>
        </div>
    </div>
</div>

<script>
    // Check if this event is already favourited and fill the heart
    fetch('/WhatsOn/IsFavourited?eventId=@Model.EventId')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.favourited) {
                var icon = document.getElementById('heart-icon');
                icon.classList.remove('far');
                icon.classList.add('fas');
                document.getElementById('heart-btn').classList.add('active');
            }
        });
</script>