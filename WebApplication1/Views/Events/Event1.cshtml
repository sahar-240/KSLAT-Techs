@{
    ViewData["Title"] = "Iris Van Herpen";
    Layout = "_Layout";
}

<!-- Link to events CSS -->
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<div class="event-detail-card">
    <!-- Image + vertical title -->
    <div class="event-detail-image-section">
        <a href="/WhatsOn/Events" class="event-detail-back" title="Return to Events">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div class="event-detail-image">
            <img src="~/images/Picture11.png" alt="Iris Van Herpen">
            </div>
            <div class="event-detail-title-box">
                <div class="event-detail-title-wrapper">
                    <span class="event-detail-label">EXHIBITION</span>
                    <span class="event-detail-title" style="color: #B6827C;">IRIS VAN HERPEN</span>
                </div>
            </div>
        </div>

        <!-- Coloured info section -->
        <div class="event-detail-info" style="background-color: #B6827C;">
            <div class="event-detail-date-box">
                <div class="event-detail-year">2026</div>
                <div class="event-detail-date-row">
                    <div class="event-detail-date-number">16</div>
                    <div class="event-detail-date-divider"></div>
                    <div class="event-detail-date-number">31</div>
                </div>
                <div class="event-detail-date-labels">
                    <div class="event-detail-date-label">APR</div>
                    <div class="event-detail-date-label">MAY</div>
                </div>
            </div>

            <div class="event-detail-content">
                <div class="event-detail-item">
                    <span class="event-detail-item-label">TIME</span>
                    <span>DAILY 10:00 AM - 6:00 PM</span>
                </div>
                <div class="event-detail-item">
                    <span class="event-detail-item-label">LOCATION</span>
                    <span>ELIZABETH GALLERY, FLOOR 1</span>
                </div>
                <div class="event-detail-description">
                    Dutch fashion designer Iris Van Herpen merges couture with nature through biomimetic inspiration. Her work explores the intersection of organic forms and innovative technology in haute couture design. This exhibition showcases her revolutionary approach to fashion, where architectural precision meets natural beauty. Each garment represents a dialogue between technology and nature, presenting silhouettes that seem to defy conventional design boundaries.
                </div>
                <div class="event-detail-footer">
                    <button class="event-detail-heart" onclick="toggleHeart(this)" title="Save to favorites">
                        <i class="far fa-heart"></i>
                    </button>
                    <a href="/WhatsOn/EventBook?event=Iris Van Herpen" class="event-detail-book-btn">BOOK</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleHeart(element) {
            var icon = element.querySelector('i');
            element.classList.toggle('active');
            icon.classList.toggle('far');
            icon.classList.toggle('fas');
        }
    </script>