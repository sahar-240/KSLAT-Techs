@model List<WebApplication1.Models.Event>
@{
    ViewData["Title"] = "Events";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<section class="events-hero">
    <div class="events-hero-box">
        <h1>EVENTS</h1>
        <p>Discover our current exhibitions and workshops</p>
    </div>
</section>

<section style="padding: 0 60px 150px 60px;">

    <!-- Filter and sort controls -->
    <div class="events-filter-bar">
        <div class="events-filter-group">
            <label>GENRE:</label>
            <select class="events-filter-dropdown" id="genre-filter" onchange="applyFilters()">
                <option value="">ALL GENRES</option>
                <option value="Fashion">FASHION</option>
                <option value="Photography">PHOTOGRAPHY</option>
                <option value="Paintings/Drawings">PAINTINGS/DRAWINGS</option>
                <option value="Workshop">WORKSHOP</option>
            </select>
        </div>

        <a href="/Account/Saved" class="events-btn-primary">
            <i class="fas fa-heart"></i> FAVOURITES
        </a>

        <div class="events-filter-group">
            <label>SORT:</label>
            <select class="events-filter-dropdown" id="sort-filter" onchange="applyFilters()">
                <option value="newest">NEWEST</option>
                <option value="oldest">OLDEST</option>
                <option value="a-z">A-Z</option>
                <option value="z-a">Z-A</option>
                <option value="ending">ENDING SOON</option>
            </select>
        </div>
    </div>

    <!-- Event cards -->
    <div class="events-grid" id="events-grid">
        @foreach (var ev in Model)
        {
            <div class="events-card"
                 data-event-id="@ev.EventId"
                 data-genre="@ev.Genre"
                 data-title="@ev.EventType: @ev.Title"
                 data-sort-title="@ev.Title.ToLower()"
                 data-start-date="@ev.StartDate.ToString("yyyyMMdd")"
                 data-end-date="@ev.EndDate.ToString("yyyyMMdd")"
                 style="border: 10px solid @ev.ThemeColour; background-color: #2b2b2b; display: flex; flex-direction: column;">

                <div class="events-card-image">
                    <img src="@Url.Content(ev.ImagePath)" alt="@ev.Title">
                </div>

                <div style="padding: 16px 18px; flex: 1; display: flex; flex-direction: column;">

                    <!-- Title -->
                    <div style="margin-bottom: 8px;">
                        <span style="color: #fff; font-weight: 700; font-size: 1.1rem; text-transform: uppercase; display: block; letter-spacing: 1px;">@ev.EventType.ToUpper():</span>
                        <span style="color: @ev.ThemeColour; font-weight: 700; font-size: 1.3rem; text-transform: uppercase; display: block; letter-spacing: 1px;">@ev.Title.ToUpper()</span>
                    </div>

                    <!-- Date range -->
                    <div style="color: #ccc; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                        <i class="far fa-calendar-alt" style="margin-right: 6px; color: @ev.ThemeColour;"></i>
                        @ev.StartDate.ToString("dd MMM") &ndash; @ev.EndDate.ToString("dd MMM yyyy")
                    </div>

                    <!-- Location -->
                    <div style="color: #ccc; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">
                        <i class="fas fa-map-marker-alt" style="margin-right: 6px; color: @ev.ThemeColour;"></i>
                        @ev.Location
                    </div>

                    <!-- Availability and price -->
                    <div style="color: #ccc; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px;">
                        <i class="fas fa-users" style="margin-right: 6px; color: @ev.ThemeColour;"></i>
                        @ev.SpotsPerSlot SPOTS PER TIME SLOT
                        @if (ev.IsFreeEntry)
                        {
                            <span style="margin-left: 10px; color: @ev.ThemeColour; font-weight: 700;">&bull; FREE ENTRY</span>
                        }
                    </div>

                    <!-- Description -->
                    <p style="color: #ddd; font-size: 0.78rem; text-transform: uppercase; line-height: 1.6; letter-spacing: 0.5px; flex: 1;">@ev.Description</p>

                    <!-- Book button and heart -->
                    <div style="display: flex; align-items: center; justify-content: center; gap: 18px; padding-top: 12px; padding-bottom: 6px;">
                        <a asp-action="EventDetail" asp-route-id="@ev.EventId"
                           style="background-color: #fff; color: #222; padding: 8px 30px; text-decoration: none; font-weight: 700; font-size: 0.85rem; letter-spacing: 1px; border: none; transition: all 0.3s;"
                           onmouseover="this.style.backgroundColor='#2d5f3f'; this.style.color='#fff';"
                           onmouseout="this.style.backgroundColor='#fff'; this.style.color='#222';">BOOK</a>

                        <button type="button" class="events-btn-heart heart-btn-@ev.EventId"
                                onclick="toggleFavourite(@ev.EventId)" title="Save to favourites">
                            <i class="far fa-heart" id="heart-icon-@ev.EventId"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        // Filters event cards by genre and re-sorts them
        function applyFilters() {
            var genreFilter = document.getElementById('genre-filter').value;
            var sortFilter = document.getElementById('sort-filter').value;
            var cards = document.querySelectorAll('.events-card');

            cards.forEach(function (card) {
                var genre = card.getAttribute('data-genre');
                card.style.display = (genreFilter === '' || genre === genreFilter) ? 'flex' : 'none';
            });

            var visibleCards = Array.from(cards).filter(function (card) {
                return card.style.display !== 'none';
            });
            visibleCards.sort(function (a, b) { return getSortValue(a, b, sortFilter); });

            var grid = document.getElementById('events-grid');
            visibleCards.forEach(function (card) { grid.appendChild(card); });
        }

        function getSortValue(a, b, sortType) {
            switch (sortType) {
                case 'a-z':    return a.dataset.sortTitle.localeCompare(b.dataset.sortTitle);
                case 'z-a':    return b.dataset.sortTitle.localeCompare(a.dataset.sortTitle);
                case 'oldest': return parseInt(a.dataset.startDate) - parseInt(b.dataset.startDate);
                case 'ending': return parseInt(a.dataset.endDate) - parseInt(b.dataset.endDate);
                default:       return parseInt(b.dataset.startDate) - parseInt(a.dataset.startDate);
            }
        }

        // Toggle favourite via AJAX — stays on the Events page
        function toggleFavourite(eventId) {
            fetch('/WhatsOn/ToggleFavouriteAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ eventId: eventId })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) {
                    alert(data.message);
                    return;
                }
                var icon = document.getElementById('heart-icon-' + eventId);
                var btn = document.querySelector('.heart-btn-' + eventId);
                if (data.favourited) {
                    icon.classList.remove('far');
                    icon.classList.add('fas');
                    btn.classList.add('active');
                } else {
                    icon.classList.remove('fas');
                    icon.classList.add('far');
                    btn.classList.remove('active');
                }
            });
        }

        // On page load, check which events are already favourited
        document.querySelectorAll('.events-card').forEach(function(card) {
            var eventId = card.getAttribute('data-event-id');
            fetch('/WhatsOn/IsFavourited?eventId=' + eventId)
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.favourited) {
                        var icon = document.getElementById('heart-icon-' + eventId);
                        if (icon) {
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                        }
                        var btn = document.querySelector('.heart-btn-' + eventId);
                        if (btn) btn.classList.add('active');
                    }
                });
        });
    </script>
}