@model WebApplication1.Models.Donation

@{
    ViewData["Title"] = "Donation Confirmation";
    Layout = "_Layout";
}

<div style="max-width: 800px; margin: 60px auto; padding: 40px; text-align: center; background-color: #f9f9f9; border-radius: 8px;">
    <div style="font-size: 48px; color: #2d5f3f; margin-bottom: 20px;">✓</div>
    
    <h1 style="color: #2d5f3f; margin-bottom: 10px;">THANK YOU FOR YOUR DONATION!</h1>
    
    <p style="font-size: 16px; color: #666; margin-bottom: 30px;">
        Your generous contribution means the world to us.
    </p>

    <!-- Donation Details -->
    <div style="background-color: white; padding: 30px; border-radius: 8px; margin-bottom: 30px; text-align: left;">
        <h3 style="color: #2d5f3f; margin-bottom: 20px; border-bottom: 2px solid #2d5f3f; padding-bottom: 10px;">
            DONATION DETAILS
        </h3>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                <strong>Donation ID:</strong>
                <p style="color: #666;">@Model.Id</p>
            </div>
            <div>
                <strong>Amount:</strong>
                <p style="color: #2d5f3f; font-size: 20px; font-weight: bold;">£@Model.Amount.ToString("F2")</p>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <div>
                <strong>Date:</strong>
                <p style="color: #666;">@Model.DonationDate.ToString("dd MMMM yyyy HH:mm")</p>
            </div>
            <div>
                <strong>Status:</strong>
                <p style="color: #2d5f3f; font-weight: bold;">@Model.Status</p>
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <strong>Donor Name:</strong>
            <p style="color: #666;">@Model.FirstName @Model.LastName</p>
        </div>

        <div style="margin-bottom: 20px;">
            <strong>Email:</strong>
            <p style="color: #666;">@Model.Email</p>
        </div>

        <div style="margin-bottom: 20px;">
            <strong>Address:</strong>
            <p style="color: #666;">
                @Model.Address<br />
                @Model.City, @Model.Postcode<br />
                @Model.Country
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div style="margin-bottom: 20px;">
                <strong>Message:</strong>
                <p style="color: #666; font-style: italic;">@Model.Message</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.TransactionId))
        {
            <div>
                <strong>Transaction ID:</strong>
                <p style="color: #666;">@Model.TransactionId</p>
            </div>
        }
    </div>

    <p style="font-size: 14px; color: #999; margin-bottom: 20px;">
        A confirmation email has been sent to @Model.Email
    </p>

    <!-- Action Buttons -->
    <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="@Url.Action("Index", "Home")"
               style="padding: 12px 30px; background-color: #2d5f3f; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
            BACK TO HOME
        </a>
        <a href="@Url.Action("Support", "Home")"
               style="padding: 12px 30px; background-color: #666; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">
            SUPPORT US
        </a>
    </div>
</div>
