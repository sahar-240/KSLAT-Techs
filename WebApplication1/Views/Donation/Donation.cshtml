@{
    ViewData["Title"] = "Donate";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/donation.css">

    <!-- Hero Section -->
    <div class="donation-hero">
        <img src="~/images/Picture7.png" alt="Donate" class="hero-image" />
        <div class="hero-overlay">
            <div class="hero-content">
                <h1 class="hero-title">DONATE</h1>
            </div>
        </div>
    </div>

    <!-- Donation Form -->
    <div class="donation-container">
        <!-- Introduction -->
        <div class="donation-intro">
            <h2 class="intro-title">DONATE</h2>
            <p class="intro-text">
                THE NATURAL GALLERY RELIES ON YOUR GENEROUS GIFT HELPS THE GALLERY SHARE ITS ART WITH THE WORLD. THANK YOU.
            </p>
        </div>

        <!-- FIXED: Changed action to Donation controller -->
        <form id="donationForm" method="post" action="@Url.Action("Donation", "Donation")">
            <!-- Amount Selection -->
            <div class="amount-section">
                <div class="amount-buttons">
                    <button type="button" class="amount-btn" data-amount="5" onclick="selectAmount(this, 5)">£5</button>
                    <button type="button" class="amount-btn" data-amount="10" onclick="selectAmount(this, 10)">£10</button>
                    <button type="button" class="amount-btn" data-amount="20" onclick="selectAmount(this, 20)">£20</button>
                    <button type="button" class="amount-btn" data-amount="50" onclick="selectAmount(this, 50)">£50</button>
                    <button type="button" class="amount-btn" data-amount="other" onclick="selectAmount(this, 'other')">OTHER</button>
                </div>

                <!-- Custom Amount Input -->
                <div class="custom-amount-wrapper" id="customAmountWrapper">
                    <label class="custom-amount-label">ENTER CUSTOM AMOUNT (£)</label>
                    <input type="number" class="custom-amount-input" id="customAmountInput"
                           placeholder="0.00" min="1" step="0.01" />
                </div>

                <p class="select-amount-text">SELECT AN AMOUNT</p>
                <input type="hidden" id="donationAmount" name="Amount" value="" />
            </div>

            <!-- Info Box -->
            <div class="info-box">
                <h4>YOUR GIFT MATTERS</h4>
                <p>WITH YOUR GENEROUS DONATION TO HELP AND SHARE THE ARTS WITH FUTURE AUDIENCES, YOU ARE MAKING A REAL DIFFERENCE.</p>
                <p>YOUR CONTRIBUTION HELPS US TO MAINTAIN AND DEVELOP OUR COLLECTION, SUPPORT IMPORTANT EXHIBITIONS AND PROGRAMMES, AND ENSURE WE CAN REACH MORE PEOPLE WITH THE ART AND CULTURE WE HOLD DEAR.</p>
                <p>WE ARE DEEPLY GRATEFUL FOR YOUR SUPPORT AND GENEROSITY.</p>
            </div>

            <!-- Comment Section -->
            <div class="comment-section">
                <label class="comment-title">LEAVE A COMMENT (OPTIONAL)</label>
                <textarea class="comment-textarea" name="Message" placeholder="Your message..."></textarea>
            </div>

            <!-- Billing Address -->
            <div class="billing-section">
                <h3 class="section-title">BILLING ADDRESS</h3>

                <div class="form-group">
                    <label class="form-label">NAME *</label>
                    <div class="form-row">
                        <input type="text" class="form-control" name="FirstName" placeholder="First Name" required />
                        <input type="text" class="form-control" name="LastName" placeholder="Last Name" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">EMAIL *</label>
                    <input type="email" class="form-control" name="Email" placeholder="Your Email" required />
                </div>

                <div class="form-group">
                    <label class="form-label">PHONE (OPTIONAL)</label>
                    <input type="tel" class="form-control" name="Phone" placeholder="Your Phone" />
                </div>

                <div class="form-group">
                    <label class="form-label">ADDRESS *</label>
                    <input type="text" class="form-control" name="Address" placeholder="Street Address" required />
                </div>

                <div class="form-group">
                    <label class="form-label">CITY & COUNTRY *</label>
                    <div class="form-row">
                        <input type="text" class="form-control" name="City" placeholder="City" required />
                        <input type="text" class="form-control" name="Country" placeholder="Country" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">POSTCODE</label>
                    <input type="text" class="form-control" name="Postcode" placeholder="Postcode" />
                </div>
            </div>

            <!-- Agreement & Newsletter -->
            <div class="agreement-section">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input type="checkbox" name="SubscribeNewsletter" value="true" />
                    <span>
                        I WISH TO RECEIVE THE NATURAL GALLERY'S MONTHLY NEWSLETTER. BY PROVIDING YOUR EMAIL ADDRESS, YOU AGREE TO RECEIVE COMMUNICATIONS FROM NATURAL GALLERY. WE WILL HANDLE YOUR DATA IN ACCORDANCE WITH OUR PRIVACY POLICY.
                    </span>
                </label>
            </div>

            <!-- Submit Button -->
            <div class="submit-section">
                <button type="submit" class="submit-btn">PROCEED TO PAYMENT</button>
            </div>
        </form>
    </div>

    @section Scripts {
        <script>
            function selectAmount(element, amount) {
                // Remove active class from all buttons
                document.querySelectorAll('.amount-btn').forEach(btn => {
                    btn.classList.remove('active');
                });

                // Add active class to clicked button
                element.classList.add('active');

                // Get the custom amount wrapper
                const customWrapper = document.getElementById('customAmountWrapper');
                const customInput = document.getElementById('customAmountInput');
                const amountInput = document.getElementById('donationAmount');

                if (amount === 'other') {
                    // Show custom input field
                    customWrapper.classList.add('active');
                    customInput.focus();
                    amountInput.value = '';
            
                    // Update amount when user types
                    customInput.addEventListener('input', function() {
                        if (this.value) {
                            amountInput.value = this.value;
                        }
                    });
                } else {
                    // Hide custom input field
                    customWrapper.classList.remove('active');
                    customInput.value = '';
                    amountInput.value = amount;
                }
            }

            document.getElementById('donationForm').addEventListener('submit', function(e) {
                const amount = document.getElementById('donationAmount').value;
                if (!amount || amount <= 0) {
                    e.preventDefault();
                    alert('Please select or enter a donation amount');
                    return false;
                }
            });

            // Allow pressing Enter in custom amount input to set the value
            document.getElementById('customAmountInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && this.value) {
                    document.getElementById('donationAmount').value = this.value;
                }
            });
        </script>
    }