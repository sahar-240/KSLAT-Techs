@model WebApplication1.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-section">
    <img src="~/images/Picture1.png" alt="Hero Background" class="hero-image" />
    <div class="hero-overlay">
        <h1 class="hero-title">NATURAL GALLERY</h1>
        <p>Where Art Preserves Memory.</p>
    </div>
</div>

<!-- Who Are We Section -->
<section class="who-are-we">
    <div class="who-are-we-content">
        <h2>WHO ARE WE?</h2>
        <p>
            WE ARE A CONTEMPORARY MUSEUM WHERE ART ACTS AS A LIVING ARCHIVE.

            THROUGH EXHIBITIONS, COLLECTIONS, AND INTERDISCIPLINARY PRACTICE, WE EXPLORE HOW CREATIVITY PRESERVES MEMORY, INTERPRETS THE NATURAL WORLD, AND REFLECTS THE SHIFTING RELATIONSHIP BETWEEN HUMANITY AND ITS ENVIRONMENT.

            OUR PROGRAMME BRINGS TOGETHER HISTORICAL WORKS, SCIENTIFIC DOCUMENTATION, AND CONTEMPORARY ART — EXAMINING TRANSFORMATION, RESILIENCE, EXTINCTION, AND RENEWAL.
        </p>
    </div>
</section>

<!-- MISSION SECTION -->
<section class="mission">
    <h2>Mission</h2>
    <div class="mission-content">
        <div class="mission-image">
            <img src="~/images/Picture2.png" alt="Our Mission" />
        </div>
        <div class="mission-text">
            <h3>OUR MISSION</h3>
            <p>WE BELIEVE ART IS A LANGUAGE — ONE THAT PRESERVES MEMORY, CHALLENGES THE PRESENT, AND SHAPES THE FUTURE.</p>
            <p>THROUGH EXHIBITIONS THAT CONNECT NATURE, HISTORY, AND INNOVATION, WE INVITE VISITORS TO SEE THE WORLD DIFFERENTLY AND RECOGNISE THEIR ROLE WITHIN IT.</p>
        </div>
    </div>
</section>

<!-- SUPPORT SECTION -->
<section class="support">
    <h2>Support</h2>
    <div class="support-content">
        <div class="support-text">
            <h3>SUPPORT US</h3>
            <p>YOUR SUPPORT HELPS SUSTAIN FUTURE WORKSHOPS AND THE CONTINUED PRESERVATION OF OUR HISTORY.</p>
            <p>FOR MORE INFORMATION:</p>
            <a asp-controller="Home" asp-action="Support" class="btn btn-primary">Support Us</a>
        </div>
        <div class="support-image">
            <img src="~/images/Picture3.png" alt="Support Us" />
        </div>
    </div>
</section>

<!-- Opening Hours Section -->
<section class="opening-hours">
    <div class="container">
        <h2>PLAN YOUR VISIT</h2>
        <h3>OPENING HOURS</h3>
        <div class="hours-list" id="hoursList">
            @if (Model?.OpeningHours != null && Model.OpeningHours.Any())
            {
                @foreach (var hour in Model.OpeningHours)
                {
                    <div class="hours-item" data-day="@hour.DayOfWeek">
                        <span class="day">@hour.DayOfWeek</span>
                        <span class="time">
                            @if (hour.IsClosed)
                            {
                                <text>CLOSED</text>
                            }
                            else
                            {
                                <text>@hour.OpeningTime?.ToString(@"hh\:mm") - @hour.ClosingTime?.ToString(@"hh\:mm")</text>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(hour.Notes))
                        {
                            <span class="notes" style="font-size: 12px; color: #666; margin-left: 10px;">(@hour.Notes)</span>
                        }
                    </div>
                }
            }
            else
            {
                <p>Opening hours not available.</p>
            }
        </div>
        <div class="hours-disclaimer">
            <p>OPENING HOURS MAY BE SUBJECT TO CHANGE<br />PLEASE CONTACT US</p>
        </div>
    </div>
</section>

        <!-- Membership Section -->
        <section class="membership">
            <div class="membership-content">
                <div class="membership-image">
                    <img src="~/images/Picture4.png" alt="Museum Collections" />
                </div>
                <div class="membership-info">
                    <h2>BECOME A MEMBER</h2>
                    <p>DISCOUNTS</p>
                    <p>MEMBER ONLY COLLECTIONS</p>
                    <p>MODIFY &amp; VIEW TICKETS</p>
                    <p>SIGN UP FOR FREE</p>
                    <a asp-controller="SignUp" asp-action="SignUp" class="btn btn-primary">SIGN UP</a>
                </div>
            </div>
        </section>
        <!-- Accessibility Section -->
        <section class="accessibility">
            <div class="container">
                <h2>ACCESSIBILITY</h2>
                <div class="accessibility-grid">
                    <div class="accessibility-item">
                        <h3>PHYSICAL</h3>
                        <ul>
                            <li>STEP-FREE ENTRANCE</li>
                            <li>LIFT ACCESS TO ALL FLOORS</li>
                            <li>ACCESSIBLE TOILETS</li>
                            <li>WHEELCHAIR-FRIENDLY GALLERIES</li>
                            <li>SEATING THROUGHOUT EXHIBITIONS</li>
                        </ul>
                    </div>
                    <div class="accessibility-item">
                        <h3>SENSORY</h3>
                        <ul>
                            <li>AUDIO DESCRIPTIONS</li>
                            <li>CAPTIONED VIDEO INSTALLATIONS</li>
                            <li>LARGE PRINT GUIDES</li>
                            <li>HEARING LOOPS AT RECEPTION</li>
                            <li>QUIET VISITING HOURS*</li>
                            <li style="font-size: 0.8rem; margin-top: 0.5rem;">*WED & THUR 12:00-18:00</li>
                        </ul>
                    </div>
                    <div class="accessibility-item">
                        <h3>ASSISTED</h3>
                        <ul>
                            <li>FREE COMPANION TICKET</li>
                            <li>ASSISTANCE ANIMALS WELCOME</li>
                            <li>ADAPTED GUIDED TOURS AVAILABLE*</li>
                            <li style="font-size: 0.8rem; margin-top: 0.5rem;">*PLEASE CONTACT US IN ADVANCE</li>
                        </ul>
                    </div>
                </div>
                <p class="accessibility-bottom-text">+ IF YOU REQUIRE SPECIFIC ACCOMMODATIONS, PLEASE CONTACT US IN ADVANCE +</p>
            </div>
        </section>
        <!-- Location Section -->
        <section class="location">
            <div class="container">
                <h2>FIND US</h2>
                <div class="location-content">
            <div class="map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2483.5849609503636!2d-0.17641!3d51.496355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x487604d5d5e5e5e5%3A0x1e5e5e5e5e5e5e5!2sNatural%20History%20Museum!5e0!3m2!1sen!2suk!4v1234567890"
                        style="border:0; width: 100%; height: 500px;"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
                    <div class="location-info">
                        <h3>LOCATION</h3>
                        <p>Natural History Mueseum<br />Cromwell Rd,<br />South Kensington,<br />LONDON SW7 5BD</p>
                <a href="https://www.google.com/maps/search/The+Burrows+Hendon+Way+London+NW4+4BT" target="_blank" class="btn btn-primary">DIRECTIONS</a>
                    </div>
                </div>
            </div>
        </section>

<!-- FAQ Section -->
<section class="faq">
    <div class="container">
        <div class="faq-list">
            <div class="faq-header">FAQ</div>
            @if (Model?.FAQs != null && Model.FAQs.Any())
            @foreach (var faq in Model.FAQs)
            {
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        @faq.Question
                    </div>
                    <div class="faq-answer">
                        <p>@faq.Answer</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

 @section Scripts {
    <script>
        function highlightTodaysHours() {
            const days = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];
            const today = days[new Date().getDay()];
            
            const hoursItems = document.querySelectorAll('.hours-item');
            hoursItems.forEach(item => {
                if (item.getAttribute('data-day') === today) {
                    item.classList.add('today');
                }
            });
        }

        function toggleFAQ(element) {
            const faqItem = element.parentElement;
            const isActive = faqItem.classList.contains('active');
            
            // Close all other FAQ items
            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('active');
            });
            
            // Toggle current item
            if (!isActive) {
                faqItem.classList.add('active');
            }
        }

        // Run on page load
        document.addEventListener('DOMContentLoaded', function () {
            highlightTodaysHours();
        });

    </script>
}