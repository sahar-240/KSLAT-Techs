@{
    ViewData["Title"] = "Support Us";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/support.css">

    <!-- Hero Section -->
    <div class="support-hero">
        <img src="~/images/Picture5.png" alt="Support Us" class="hero-image" />
        <div class="hero-overlay">
            <div class="hero-content">
                <h1 class="hero-title">SUPPORT US</h1>
            </div>
        </div>
    </div>

    <!-- Support Introduction -->
    <div class="support-intro">
        <h2 class="intro-title">SUPPORT US</h2>
        <p class="intro-text">
            YOUR SUPPORT IS VITAL FOR HELPING US SHARE THE ART, HISTORY OF HISTORY.
            THE NATURAL GALLERY RELIES ON CONTRIBUTIONS FROM A WIDE RANGE OF DONORS AND THEIR
            GENEROSITY IS ESSENTIAL. SUPPORT US IN A NUMBER OF WAYS.
        </p>
    </div>

    <!-- Support Sections -->
    <div class="support-sections">
        <!-- Volunteer Section -->
        <div class="support-section">
            <img src="~/images/Picture6.png" alt="Volunteer" class="section-image" />
            <div class="section-content">
                <h3 class="section-title">VOLUNTEER</h3>
                <p class="section-text">SHARE YOUR KNOWLEDGE AND SKILLS WITH OUR TEAM.</p>
                <p class="section-text">MAKE A POSITIVE DIFFERENCE BY VOLUNTEERING YOUR TIME AND EXPERTISE.</p>
                <p class="section-text">ALL VOLUNTEERS MUST BE 16 OR OLDER.</p>
                <p class="section-text">PLEASE CONTACT US AT: +44 (0)20 7942 5000</p>
            </div>
        </div>

        <!-- Donate Section -->
        <div class="support-section">
            <img src="~/images/Picture7.png" alt="Donate" class="section-image" />
            <div class="section-content">
                <h3 class="section-title">DONATE</h3>
                <p class="section-text">YOUR DONATION HELPS OUR GALLERY NEED TO CONTINUE ITS MISSION.</p>
                <ul class="section-list">
                    <li>A DONATION OF ANY SIZE IS DEEPLY APPRECIATED</li>
                    <li>LARGE GIFTS MAKE A BIG IMPACT ON THE GALLERY</li>
                    <li>WE ARE TRULY THANKFUL FOR YOUR SUPPORT</li>
                </ul>
                <a asp-controller="Home" asp-action="Donation" class="donate-btn">DONATE</a>
            </div>
        </div>

        <!-- Become A Patron Section (Full Width) -->
        <div class="support-section full-width">
            <img src="~/images/Picture8.png" alt="Become a Patron" class="section-image" />
            <div class="section-content">
                <h3 class="section-title">BECOME A PATRON</h3>
                <p class="section-text">HELP PRESERVE AND ENHANCE THE NATURAL GALLERY'S PATRON.</p>
                <ul class="section-list">
                    <li>FUNDING OF NEW EXHIBITIONS AND PERMANENT COLLECTIONS</li>
                    <li>SUPPORT FOR CONSERVATION AND RESTORATION PROJECTS</li>
                    <li>EDUCATIONAL PROGRAMME SPONSORSHIP</li>
                    <li>RESEARCH - CLOSE ANNUALLY</li>
                </ul>
                <p class="section-text">PLEASE CONTACT US AT: +44 (0)20 7942 5000</p>
            </div>
        </div>
    </div>