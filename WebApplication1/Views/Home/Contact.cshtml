@model WebApplication1.Models.ContactViewModel
@using WebApplication1.Models
@{
    ViewData["Title"] = "Contact Us";
}

<!-- Hero Section -->
<section class="hero">
    <div class="hero-content">
        <h1>CONTACT US</h1>
        <p>We'd love to hear from you</p>
    </div>
</section>

<!-- Contact Information Section -->
<section class="contact-info-section">
    <div class="container">
        <h2>GET IN TOUCH</h2>
        <div class="contact-info-grid">
            <div class="contact-info-item">
                <h3>PHONE</h3>
                <p><a href="tel:020-7942-5000">020-7942-5000</a></p>
                <p class="contact-subtitle">Monday - Sunday: 9:00 AM - 6:00 PM</p>
            </div>
            <div class="contact-info-item">
                <h3>EMAIL</h3>
                <p><a href="mailto:info@museum.com">info@museum.com</a></p>
                <p class="contact-subtitle">We'll respond within 24 hours</p>
            </div>
            <div class="contact-info-item">
                <h3>ADDRESS</h3>
                <p>Cromwell Road<br>London SW7 5BD<br>United Kingdom</p>
                <p class="contact-subtitle"><a href="#">Get Directions</a></p>
            </div>
        </div>
    </div>
</section>

<!-- Contact Form Section -->
<section class="contact-form-section">
    <div class="container">
        <div class="contact-wrapper">
            <h2>SEND US A MESSAGE</h2>
            
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form method="post" id="contact-form">
                
                <!-- CSRF Token -->
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name *</label>
                        <input type="text" id="name" name="name" asp-for="Name" required>
                            <span class="field-validation-error" asp-validation-for="Name"></span>
                        </div>
                        <div class="form-group">
                            <label for="email">Email Address *</label>
                            <input type="email" id="email" name="email" asp-for="Email" required>
                                <span class="field-validation-error" asp-validation-for="Email"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="phone">Phone Number</label>
                                <input type="tel" id="phone" name="phone" asp-for="Phone">
                                    <span class="field-validation-error" asp-validation-for="Phone"></span>
                                </div>
                                <div class="form-group">
                                    <label for="department">Department</label>
                                    <select id="department" name="department" asp-for="Department">
                                        <option value="">Select a department</option>
                                        <option value="general">General Inquiry</option>
                                        <option value="events">Events & Bookings</option>
                                        <option value="education">Education Programs</option>
                                        <option value="membership">Membership</option>
                                        <option value="support">Support & Donations</option>
                                        <option value="accessibility">Accessibility</option>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="subject">Subject *</label>
                                <input type="text" id="subject" name="subject" asp-for="Subject" required>
                                    <span class="field-validation-error" asp-validation-for="Subject"></span>
                                </div>

                                <div class="form-group">
                                    <label for="message">Message *</label>
                                    <textarea id="message" name="message" asp-for="Message" rows="6" required></textarea>
                                    <span class="field-validation-error" asp-validation-for="Message"></span>
                                </div>

                                <div class="form-group">
                                    <label>
                                        <input type="checkbox" name="subscribeNewsletter" asp-for="SubscribeNewsletter">
                                            I'd like to receive updates about exhibitions and events
                                        </label>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-large">SEND MESSAGE</button>
                                </form>
                            </div>
                        </div>
                    </section>

                    <!-- FAQ Section -->
                    <section class="contact-faq">
                        <div class="container">
                            <h2>FREQUENTLY ASKED QUESTIONS</h2>
                            <div class="faq-list">
                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <h4>What are your opening hours?</h4>
                                    </div>
                                    <div class="faq-answer">
                                        <p>We are open daily from 10:00 AM to 5:50 PM (last entry at 5:00 PM). We are closed on 24, 25 and 26 December and certain public holidays.</p>
                                    </div>
                                </div>

                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <h4>How do I book a school visit?</h4>
                                    </div>
                                    <div class="faq-answer">
                                        <p>Please contact our education team at education@museum.com or call 020-7942-5000 ext. 5001. We offer group rates and educational programs for schools.</p>
                                    </div>
                                </div>

                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <h4>Do you have parking available?</h4>
                                    </div>
                                    <div class="faq-answer">
                                        <p>There are several car parks near the museum. We recommend using the South Kensington car park, which is located directly beneath the museum.</p>
                                    </div>
                                </div>

                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <h4>Is the museum accessible for wheelchair users?</h4>
                                    </div>
                                    <div class="faq-answer">
                                        <p>Yes, the museum is fully wheelchair accessible with accessible entrances, elevators, and facilities. Please call us for more information about accessibility services.</p>
                                    </div>
                                </div>

                                <div class="faq-item">
                                    <div class="faq-question" onclick="toggleFAQ(this)">
                                        <h4>How long does a typical visit take?</h4>
                                    </div>
                                    <div class="faq-answer">
                                        <p>A typical visit takes 2-3 hours, but you can spend as much time as you like. Many visitors return multiple times to explore different galleries.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    @section Scripts {
                        @{
                            await Html.RenderPartialAsync("_ValidationScriptsPartial");
                        }
                    }