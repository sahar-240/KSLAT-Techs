@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/contact.css" />

<!-- Hero/Title Section -->
<section class="contact-hero">
    <div class="container">
        <h1>CONTACT US</h1>
        <p class="contact-subtitle">We'd love to hear from you</p>
    </div>
</section>

<!-- Contact Section -->
<section class="contact">
    <div class="container">
        <!-- Get In Touch -->
        <div class="get-in-touch">
            <h2>GET IN TOUCH</h2>
            
            <!-- Contact Info Grid -->
            <div class="contact-info-grid">
                <!-- Phone -->
                <div class="contact-info-item">
                    <h3>PHONE</h3>
                    <p>
                        <a href="tel:+442079425000">+44 (0)20 7942 5000</a><br />
                        Monday - Sunday: 9:00 AM - 6:00 PM
                    </p>
                </div>

                <!-- Email -->
                <div class="contact-info-item">
                    <h3>EMAIL</h3>
                    <p>
                        <a href="mailto:info@naturalgallery.co.uk">info@naturalgallery.co.uk</a><br />
                        We'll respond within 24 hours
                    </p>
                </div>

                <!-- Address -->
                <div class="contact-info-item">
                    <h3>ADDRESS</h3>
                    <p>
                        The Natural Gallery<br />
                        The Burrows<br />
                        London NW4 4BT<br />
                        United Kingdom
                    </p>
                </div>
            </div>
        </div>

        <!-- Send Message Section -->
        <div class="send-message">
            <h2>SEND US A MESSAGE</h2>
            
            <form class="contact-form" method="post" action="@Url.Action("SendMessage", "Contact")">
                <!-- Full Name and Email -->
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="fullName">Full Name *</label>
                        <input type="text" id="fullName" name="fullName" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="email">Email Address *</label>
                        <input type="email" id="email" name="email" class="form-control" required />
                    </div>
                </div>

                <!-- Phone Number -->
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone" class="form-control" />
                    </div>
                </div>

                <!-- Department Dropdown -->
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="department">Department *</label>
                        <select id="department" name="department" class="form-control form-control-select" required>
                            <option value="">Select a Department</option>
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Memberships">Memberships</option>
                            <option value="Events & Bookings">Events & Bookings</option>
                            <option value="Support & Donations">Support & Donations</option>
                            <option value="Accessibility">Accessibility</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <!-- Subject -->
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="subject">Subject *</label>
                        <input type="text" id="subject" name="subject" class="form-control" required />
                    </div>
                </div>

                <!-- Message -->
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="message">Message *</label>
                        <textarea id="message" name="message" class="form-control form-control-textarea" required></textarea>
                    </div>
                </div>

                <!-- Checkbox -->
                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-checkbox">
                            <input type="checkbox" name="subscribe" id="subscribe" />
                            I'D LIKE TO RECEIVE UPDATES ABOUT EXHIBITIONS AND EVENTS
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="submit-btn">SEND MESSAGE</button>
            </form>
        </div>
    </div>
</section>

