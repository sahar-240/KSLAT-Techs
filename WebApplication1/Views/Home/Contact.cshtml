@{
    ViewData["Title"] = "Contact";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/contact.css" />

<!-- Hero -->
<section class="contact-hero">
    <div class="container">
        <h1>CONTACT US</h1>
        <p class="contact-subtitle">We'd love to hear from you</p>
    </div>
</section>

<section class="contact">
    <div class="container">

        @if (TempData["ContactError"] != null)
        {
            <div style="background: #ff4444; color: #fff; padding: 14px 24px; margin-bottom: 24px; border-radius: 6px; text-align: center; font-weight: 600;">
                @TempData["ContactError"]
            </div>
        }

        <!-- Contact Information -->
        <div class="get-in-touch">
            <h2>GET IN TOUCH</h2>
            <div class="contact-info-grid">
                <div class="contact-info-item">
                    <h3>PHONE</h3>
                    <p>
                        <a href="tel:+442079425000">+44 (0)20 7942 5000</a><br />
                        Monday - Sunday: 9:00 AM - 6:00 PM
                    </p>
                </div>
                <div class="contact-info-item">
                    <h3>EMAIL</h3>
                    <p>
                        <a href="mailto:info@naturalgallery.co.uk">info@naturalgallery.co.uk</a><br />
                        We'll respond within 24 hours
                    </p>
                </div>
                <div class="contact-info-item">
                    <h3>ADDRESS</h3>
                    <p>
                        The Natural Gallery<br />
                        The Burrows<br />
                        London NW4 4BT<br />
                        United Kingdom
                    </p>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="send-message">
            <h2>SEND US A MESSAGE</h2>
            <form class="contact-form" method="post" action="@Url.Action("SendMessage", "Contact")">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label" for="Name">Full Name *</label>
                        <input type="text" id="Name" name="Name" class="form-control" required maxlength="100" />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="Email">Email Address *</label>
                        <input type="email" id="Email" name="Email" class="form-control" required />
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="Phone">Phone Number</label>
                        <input type="tel" id="Phone" name="Phone" class="form-control" maxlength="15" />
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="Department">Department *</label>
                        <select id="Department" name="Department" class="form-control form-control-select" required>
                            <option value="">Select a Department</option>
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Memberships">Memberships</option>
                            <option value="Events & Bookings">Events & Bookings</option>
                            <option value="Support & Donations">Support & Donations</option>
                            <option value="Accessibility">Accessibility</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="Subject">Subject *</label>
                        <input type="text" id="Subject" name="Subject" class="form-control" required maxlength="200" />
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-label" for="Message">Message *</label>
                        <textarea id="Message" name="Message" class="form-control form-control-textarea" required maxlength="2000"></textarea>
                    </div>
                </div>

                <div class="form-row full">
                    <div class="form-group">
                        <label class="form-checkbox">
                            <input type="checkbox" name="SubscribeNewsletter" id="SubscribeNewsletter" value="true" />
                            I'D LIKE TO RECEIVE UPDATES ABOUT EXHIBITIONS AND EVENTS
                        </label>
                    </div>
                </div>

                <button type="submit" class="submit-btn">SEND MESSAGE</button>
            </form>
        </div>
    </div>
</section>

